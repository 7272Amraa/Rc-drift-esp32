void onEncoderClick(uint32_t now){
 if(cfg.menuSound)playVoice(VO_SFX_SELECT);
 if(screen==HOME){screen=MENU;menuIndex=0;return;}
 if(screen==MENU){
   MenuItem m=(MenuItem)menuIndex;
   if(m<=MI_CAL_GEAR){beginCalibration(m);return;}
   if(m==MI_CAL_SERVO){
     if(!linked(now)){playVoice(VO_LINK_SEARCH,2);return;}
     screen=SERVO_CAL;servoStage=0;servoPreview=servoUsFromRX[0];playVoice(VO_SERVO_LEFT);return;
   }
   if(m==MI_SAVE){saveConfig();return;}
   if(m==MI_FACTORY){
     cfg=Settings();saveConfig(false);playVoice(VO_FACTORY,3);return;
   }
   if(m==MI_OTA){enterOTA();return;}
   editing=m;editValue=currentSetting(m);screen=EDIT;return;
 }
 if(screen==EDIT){applySetting(editing,editValue);saveConfig();screen=MENU;return;}
 if(screen==CALIBRATE){
   if(calStage<3)captured[calStage]=getCalibrationRaw();
   int stages=(editing==MI_CAL_STEER || editing==MI_CAL_GEAR)?3:2;
   calStage++;
   if(calStage>=stages)finishCalibration();
   return;
 }
 if(screen==SERVO_CAL){
   if(!linked(now)||pendingAction)return;
   cfg.servoUs[servoStage==0?0:servoStage==1?2:1]=servoPreview;
   servoSendAction(servoStage==0?1:servoStage==1?2:3,servoPreview,now);
 }
}
void onEncoderStep(int delta){
 if(otaMode||delta==0)return;
 if(screen==MENU)menuIndex=constrain(menuIndex+delta,0,(int)MI_COUNT-1);
 else if(screen==EDIT){
   bool toggle=editing==MI_GYRO_ENABLE||editing==MI_GYRO_REVERSE||editing==MI_STEER_REVERSE||
     editing==MI_SIGNALS||editing==MI_HEADLIGHT||editing==MI_TAIL_IDLE||
     editing==MI_MENU_SOUND||editing==MI_GEAR_VOICE||editing==MI_VOICE_ENABLE;
   editValue=constrain(editValue+delta,0,toggle?1:100);
 }
 else if(screen==SERVO_CAL && !pendingAction){
   int step=2;
   servoPreview=constrain(servoPreview+delta*step,1000,2000);
 }
 if(cfg.menuSound)playVoice(VO_SFX_CLICK,0);
}

uint32_t lastOledMs=0;
void renderOLED(uint32_t now){
 if(!oledOK || now-lastOledMs<125)return;lastOledMs=now;
 oled.clearDisplay();oled.setTextSize(1);oled.setTextColor(SSD1306_WHITE);oled.setCursor(0,0);
 if(otaMode){
   oled.println("WIFI OTA 192.168.4.1");
   oled.printf("SSID:%s\n",wifiName);
   oled.printf("PASS:%s\n",wifiPass);
   oled.println("USER:admin");
 }else if(screen==HOME){
   oled.printf("TX %.2fV  RX %s\n",batteryV,linked(now)?"OK":"--");
   oled.printf("%c T%3u%% L%3u%%\n",gear==0?'D':gear==1?'N':'R',
       (unsigned)(throttleNorm/10),(unsigned)(limitNorm/10));
   oled.printf("STR%+4d  RSSI%4d\n",steerNorm,(int)radioRSSI);
   oled.printf("HOOD:%s  HAZ:%s\n",hoodSwitch.stable==LOW?"OPEN":"CLOSE",hoodSwitch.stable==LOW?"ON":"OFF");
 }else if(screen==MENU){
   oled.printf("MENU %02d/%02d\n",menuIndex+1,(int)MI_COUNT);
   oled.printf(">%-20.20s\n",menuName[menuIndex]);
   oled.println("PRESS:OPEN");oled.println("HOLD SW:BACK");
 }else if(screen==EDIT){
   oled.printf("%-21.21s\n",menuName[editing]);
   oled.printf("VALUE: %3d\n",editValue);
   oled.println("TURN: CHANGE");oled.println("PRESS: SAVE");
 }else if(screen==CALIBRATE){
   oled.printf("%-21.21s\n",menuName[editing]);
   if(editing==MI_CAL_STEER)oled.println(calStage==0?"MOVE FULL LEFT":calStage==1?"MOVE FULL RIGHT":"RELEASE CENTER");
   else if(editing==MI_CAL_GEAR)oled.println(calStage==0?"GEAR: D":calStage==1?"GEAR: N":"GEAR: R");
   else oled.println(calStage==0?"MOVE TO MIN/IDLE":"MOVE TO MAX");
   oled.printf("ADC: %u\n",getCalibrationRaw());
   oled.println("PRESS: CAPTURE");
 }else if(screen==SERVO_CAL){
   oled.printf("SERVO %s\n",servoStage==0?"LEFT":servoStage==1?"RIGHT":"CENTER");
   oled.printf("PWM: %d us\n",servoPreview);
   oled.println(pendingAction?"WAIT RX ACK":"TURN: MOVE SERVO");
   oled.println("PRESS: SAVE STAGE");
 }
 oled.display();
}

void setup(){
 Serial.begin(115200);delay(100);
 pinMode(P_LED,OUTPUT);digitalWrite(P_LED,HIGH);
 pinMode(P_ENCA,INPUT_PULLUP);pinMode(P_ENCB,INPUT_PULLUP);
 previousAB=(digitalRead(P_ENCA)<<1)|digitalRead(P_ENCB);
 beginButton(button);beginButton(encSwitch);beginButton(hoodSwitch);
 analogReadResolution(12);
 for(uint8_t pin:{uint8_t(P_BAT),uint8_t(P_THR),uint8_t(P_STR),uint8_t(P_SPEED),uint8_t(P_TRIM),uint8_t(P_GEAR)})
   analogSetPinAttenuation(pin,ADC_11db);
 loadConfig();
 dacWrite(P_DAC,128);
 xTaskCreatePinnedToCore(audioTask,"tx_audio",4096,nullptr,1,nullptr,1);
 Wire.begin(P_SDA,P_SCL);
 for(uint8_t addr:{uint8_t(0x3c),uint8_t(0x3d)}){
   Wire.beginTransmission(addr);
   if(Wire.endTransmission()==0 && oled.begin(SSD1306_SWITCHCAPVCC,addr)){oledOK=true;break;}
 }
 initWeb();readInputs(millis());pendingGear=confirmedGear=readGear(adc.gear);
 radioStart();
 playVoice(VO_SFX_POWER,1);
 Serial.println("TX V6 AUDIO OTA, RX V4.1 compatible motion (PROTO5) + V6 accessory");
 Serial.printf("VOICES_EMBEDDED=%d OLED=%d FLASH=%lu\n",VOICES_EMBEDDED,oledOK,(unsigned long)ESP.getFlashChipSize());
}

void loop(){
 uint32_t now=millis();
 static bool deviceOnSpoken=false,searchSpoken=false;
 if(!deviceOnSpoken && now>2500){deviceOnSpoken=true;playVoice(VO_DEVICE_ON,1);}
 if(!searchSpoken && now>7500 && !everLinked){searchSpoken=true;playVoice(VO_LINK_SEARCH,1);}
 readInputs(now);
 handleButtons(now);
 int d=encoderStep();if(d)onEncoderStep(d);
 handleServoAck(now);
 if(!otaMode){
   static uint32_t lastTX=0,lastExtra=0,lastTelemetryUpdate=0;
   if(now-lastTX>=TX_PERIOD_MS){lastTX=now;controlLegacy(now);}
   if(now-lastExtra>=EXTRA_PERIOD_MS){lastExtra=now;controlExtra(now);}
   if(now-lastTelemetryUpdate>=100){lastTelemetryUpdate=now;updateTelemetry(now);}
 }else web.handleClient();
 static uint32_t lastLED=0;static bool led=true;
 if(otaMode){
   if(now-lastLED>=100){lastLED=now;led=!led;digitalWrite(P_LED,led?HIGH:LOW);}
 }else digitalWrite(P_LED,linked(now)?HIGH:(now/500)%2);
 if(otaRestart && (int32_t)(now-otaRestartAt)>=0)ESP.restart();
 renderOLED(now);
 delay(1);
}
