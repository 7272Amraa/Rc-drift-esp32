/*
  RC Drift TX v6.1 COMPACT -- ESP32-WROOM-DA / Arduino-ESP32 3.x
  OLED 128x32 SSD1306 / ESP-NOW CH6 / voice on GPIO26 DAC / web OTA
  IMPORTANT: RX V4.1 PROTO5 receives LEGACY motion, gyro and servo-calibration commands.
  WS2812, hood, hazard, 2-channel engine/exhaust and horn flags need a matching RX V6 update.
  No user Drive ARM/DISARM function. Existing RX safety-neutral-on-loss remains active.

  Pins: BAT32 (1S, 1:2 divider), THR39, STR36, LIMIT34, TRIM35, GEAR33,
  ENC16/17/SW23, BUTTON13, HOOD/HAZARD SWITCH14 (ON=LOW, OFF=open),
  OLED21/22, DAC26, LED18.
  User button 13 SHORT (<600ms): horn event. HOLD >=10s: WiFi OTA toggle.
  GPIO14 does NOT ARM motor. It only commands HOOD + HAZARD.
  IMPORTANT: 100 ADC raw counts deadzone for steering, throttle, gear and speed/trim edges.
  Build with OTA-capable 8 MB flash partition. VoiceData.h contains user audio.
*/
#include <Arduino.h>
#include <WiFi.h>
#include <WebServer.h>
#include <Update.h>
#include <Wire.h>
#include <Preferences.h>
#include <esp_now.h>
#include <esp_wifi.h>
#include <esp_system.h>
#include <esp_timer.h>
#include <esp_idf_version.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <math.h>
#include <string.h>

