// Exact 34-byte PROTO5 motion packet copied from compatible RX V4.1.
struct __attribute__((packed)) ControlPacket {
 uint32_t magic;
 uint8_t version,type,flags,mode;
 uint16_t sequence;
 int16_t steer,throttle;
 uint16_t gyroPot,speedPot,gyroSetting;
 uint16_t maxForward,maxReverse;
 uint8_t previewDir,actionCode;
 uint16_t previewValue,actionId;
 uint32_t echoTimestampUs;
};
struct __attribute__((packed)) TelemetryPacket {
 uint32_t magic;
 uint8_t version,type,linked,gyroOK;
 uint16_t rxPps,batteryMv;
 int8_t rxRssi;
 uint8_t armed,actionError;
 uint16_t actionAck;
 uint32_t echoTimestampUs;
 uint16_t servoLeftUs,servoCenterUs,servoRightUs;
};
static_assert(sizeof(ControlPacket)==34,"Legacy control layout changed");
static_assert(sizeof(TelemetryPacket)==27,"Legacy telemetry layout changed");

// Forward-looking accessory protocol; OLD RX will ignore (size and magic differ).
struct __attribute__((packed)) AccessoryPacket {
 uint32_t magic;
 uint8_t version,type;
 uint16_t sequence;
 uint8_t gear,hoodOpen,hazard,leftSignal,rightSignal,hornToggle;
 uint8_t headlights,brakeLevel,engineVol,exhaustVol,gyroEnabled,gyroReverse;
 uint8_t gyroFilter,gyroDamping,tailAtIdle,steeringReverse;
 uint16_t rpmRequest,gyroGain;
 uint8_t lightBrightness,signalEnabled;
};
static_assert(sizeof(AccessoryPacket)==30,"Accessory packet layout changed");

