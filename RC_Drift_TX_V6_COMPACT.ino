// Telemetry from legacy receiver.
portMUX_TYPE telemMux=portMUX_INITIALIZER_UNLOCKED;
TelemetryPacket latestTelem={};
volatile uint32_t lastTelemAt=0;
volatile bool haveTelem=false;
volatile int8_t downlinkRSSI=-127;
uint32_t lastConnectedAt=0;
uint32_t linkedFirstAt=0;
int8_t gyroAnnounced=-1;
bool previouslyLinked=false,everLinked=false;
uint16_t rxBatteryMv=0;
int8_t radioRSSI=-127;
bool rxGyroOK=false;
uint16_t servoUsFromRX[3]={1300,1500,1700};
uint16_t lastActionAck=0;
uint8_t lastActionError=0;
bool radioReady=false;

void onReceive(const esp_now_recv_info_t *info,const uint8_t *bytes,int len){
 if(len!=(int)sizeof(TelemetryPacket) || !info || !info->src_addr)return;
 TelemetryPacket t;memcpy(&t,bytes,sizeof(t));
 if(t.magic!=MAGIC_LEGACY || t.version!=LEGACY_VERSION || t.type!=2)return;
 portENTER_CRITICAL(&telemMux);
 latestTelem=t;lastTelemAt=millis();haveTelem=true;
 downlinkRSSI=info->rx_ctrl?info->rx_ctrl->rssi:-127;
 portEXIT_CRITICAL(&telemMux);
}
void radioStart(){
 WiFi.mode(WIFI_STA);WiFi.setSleep(false);
 esp_wifi_set_ps(WIFI_PS_NONE);
 esp_wifi_set_channel(WIFI_CHANNEL,WIFI_SECOND_CHAN_NONE);
 esp_err_t e=esp_now_init();
 if(e!=ESP_OK){Serial.printf("[ESP-NOW] init failed: %d\n",(int)e);radioReady=false;return;}
 esp_now_register_recv_cb(onReceive);
 esp_now_peer_info_t peer={};
 memcpy(peer.peer_addr,BROADCAST_MAC,6);peer.channel=WIFI_CHANNEL;peer.ifidx=WIFI_IF_STA;peer.encrypt=false;
 e=esp_now_add_peer(&peer);
 radioReady=(e==ESP_OK || e==ESP_ERR_ESPNOW_EXIST);
 Serial.printf("[ESP-NOW] channel %u, ready=%d\n",WIFI_CHANNEL,radioReady);
}
void radioStop(){if(radioReady){esp_now_deinit();radioReady=false;}WiFi.mode(WIFI_OFF);}

bool linked(uint32_t now){return haveTelem && (now-lastTelemAt)<LINK_TIMEOUT_MS;}
void updateTelemetry(uint32_t now){
 if(haveTelem){
   TelemetryPacket t;
   portENTER_CRITICAL(&telemMux);t=latestTelem;radioRSSI=downlinkRSSI;portEXIT_CRITICAL(&telemMux);
   rxBatteryMv=t.batteryMv;rxGyroOK=t.gyroOK;
   servoUsFromRX[0]=t.servoLeftUs;servoUsFromRX[1]=t.servoCenterUs;servoUsFromRX[2]=t.servoRightUs;
   lastActionAck=t.actionAck;lastActionError=t.actionError;
 }
 bool ok=linked(now);
 if(ok&&!previouslyLinked){playVoice(everLinked?VO_LINK_RESTORED:VO_LINK_OK,3);everLinked=true;linkedFirstAt=now;gyroAnnounced=-1;}
 if(!ok&&previouslyLinked){playVoice(VO_LINK_LOST,4);}
 previouslyLinked=ok;
 if(ok && now-linkedFirstAt>1500 && (int8_t)rxGyroOK!=gyroAnnounced){
   gyroAnnounced=(int8_t)rxGyroOK;playVoice(rxGyroOK?VO_GYRO_READY:VO_GYRO_ERROR,2);
 }
 static uint32_t lastBatteryAlert=0,lastRxAlert=0;
 if(batteryV<3.3f && now-lastBatteryAlert>60000UL){lastBatteryAlert=now;playVoice(VO_BAT_CRITICAL,4);}
 else if(batteryV<3.55f && now-lastBatteryAlert>180000UL){lastBatteryAlert=now;playVoice(VO_BAT_LOW,3);}
 if(ok && rxBatteryMv>0 && rxBatteryMv<6700 && now-lastRxAlert>180000UL){lastRxAlert=now;playVoice(VO_RX_BAT_LOW,3);}
}

// Servo calibration uses old RX V5 action ACK, safely staged left/right/center.
void servoSendAction(uint8_t code,int pwm,uint32_t now){
 pendingAction=code;actionId=nextActionId++;if(nextActionId==0)nextActionId=1;
 actionStarted=now;
 servoPreview=constrain(pwm,1000,2000);
}
void handleServoAck(uint32_t now){
 if(!pendingAction)return;
 if(!linked(now))return;
 if(lastActionAck==actionId){
   if(lastActionError){playVoice(VO_CAL_FAIL,3);pendingAction=0;screen=MENU;return;}
   uint8_t completeCode=pendingAction;pendingAction=0;
   if(completeCode==1){servoStage=1;servoPreview=cfg.servoUs[2];playVoice(VO_SERVO_RIGHT);}
   else if(completeCode==2){servoStage=2;servoPreview=cfg.servoUs[1];playVoice(VO_SERVO_CENTER);}
   else if(completeCode==3){saveConfig(false);playVoice(VO_CAL_OK);screen=MENU;}
 }else if(now-actionStarted>3000){
   pendingAction=0;screen=MENU;playVoice(VO_CAL_FAIL,3);
   Serial.println("[SERVO] ACK timeout; config not committed");
 }
}

void controlLegacy(uint32_t now){
 if(!radioReady)return;
 ControlPacket p={};
 p.magic=MAGIC_LEGACY;p.version=LEGACY_VERSION;p.type=1;p.sequence=++legacySeq;
 // Never motion-command during OTA or calibration/menus.
 p.mode=(screen==SERVO_CAL)?1:(screen==HOME?0:3);
 int steer=(int)steerNorm + trimNorm/5; // trim pot contributes +/-100/1000
 p.steer=(int16_t)constrain(steer,-1000,1000);
 int throttle=(gear==0?throttleNorm:(gear==2?-throttleNorm:0));
 if(screen!=HOME || !linked(now))throttle=0;
 p.throttle=(int16_t)constrain(throttle,-1000,1000);
 p.gyroPot=cfg.gyroEnabled?1000:0;
 p.speedPot=limitNorm;
 p.gyroSetting=(uint16_t)cfg.gyroGain*10;
 p.maxForward=(uint16_t)cfg.maxForward*10;
 p.maxReverse=(uint16_t)cfg.maxReverse*10;
 p.flags=0; // Steering is already reversed in steerNorm; old RX gyro reverse requires future RX update.
 if(screen==SERVO_CAL){
   p.previewValue=servoPreview;
   p.actionCode=pendingAction;
   p.actionId=actionId;
 }
 p.echoTimestampUs=micros();
 esp_now_send(BROADCAST_MAC,(uint8_t*)&p,sizeof(p));
}
void controlExtra(uint32_t now){
 if(!radioReady)return;
 AccessoryPacket a={};
 a.magic=MAGIC_EXTRA;a.version=EXTRA_VERSION;a.type=3;a.sequence=++extraSeq;
 a.gear=gear;a.hoodOpen=hoodSwitch.stable==LOW;
 a.hazard=a.hoodOpen;
 a.leftSignal=!a.hazard&&cfg.autoSignals&&steerNorm<-380;
 a.rightSignal=!a.hazard&&cfg.autoSignals&&steerNorm>380;
 a.hornToggle=hornCounter;
 a.headlights=cfg.headlights;
 a.brakeLevel=(now<brakeUntil)?100:((cfg.tailAtIdle&&(gear==1||throttleNorm<40))?30:0);
 a.engineVol=cfg.engineVolume;a.exhaustVol=cfg.exhaustVolume;
 a.gyroEnabled=cfg.gyroEnabled;a.gyroReverse=cfg.gyroReverse;
 a.gyroFilter=cfg.gyroFilter;a.gyroDamping=cfg.gyroDamping;
 a.tailAtIdle=cfg.tailAtIdle;a.steeringReverse=cfg.steerReverse;
 a.rpmRequest=(uint16_t)throttleNorm;a.gyroGain=cfg.gyroGain;
 a.lightBrightness=cfg.lightBrightness;a.signalEnabled=cfg.autoSignals;
 esp_now_send(BROADCAST_MAC,(uint8_t*)&a,sizeof(a)); // requires new RX V6
}

// 8MB OTA web updater; fresh credentials printed on OLED each time.
const char PAGE[] PROGMEM=R"HTML(
<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1">
<meta charset="utf-8"><title>RC TX OTA</title></head><body style="background:#111827;color:white;font:17px system-ui;padding:20px">
<h2>RC Drift TX Firmware OTA</h2><p>Upload compiled sketch <b>.ino.bin</b> only.</p>
<form action="/update" method="POST" enctype="multipart/form-data">
<input type="file" name="firmware" accept=".bin" required><button type="submit">Update firmware</button></form>
<p>Do not disconnect battery or leave OTA mode while updating.</p></body></html>
)HTML";
void uploadHandler(){
 HTTPUpload &u=web.upload();
 if(u.status==UPLOAD_FILE_START){
   otaAuth=web.authenticate("admin",wifiPass);
   otaOK=false;otaFailed=false;otaUploadStarted=false;
   if(!otaAuth)return;
   otaBusy=true;
   if(!u.filename.endsWith(".bin")){otaFailed=true;return;}
   otaUploadStarted=Update.begin(UPDATE_SIZE_UNKNOWN,U_FLASH);
   if(!otaUploadStarted){otaFailed=true;Update.printError(Serial);}
 }else if(u.status==UPLOAD_FILE_WRITE){
   if(otaAuth&&otaUploadStarted&&!otaFailed && Update.write(u.buf,u.currentSize)!=u.currentSize){
     Update.printError(Serial);Update.abort();otaUploadStarted=false;otaFailed=true;
   }
 }else if(u.status==UPLOAD_FILE_END){
   if(otaAuth&&otaUploadStarted&&!otaFailed){
     otaOK=Update.end(true);if(!otaOK)Update.printError(Serial);
   }
   otaUploadStarted=false;
 }else if(u.status==UPLOAD_FILE_ABORTED){
   if(otaUploadStarted)Update.abort();otaUploadStarted=false;otaFailed=true;otaBusy=false;
 }
}
void initWeb(){
 web.on("/",HTTP_GET,[](){
   if(!web.authenticate("admin",wifiPass)){web.requestAuthentication();return;}
   web.send_P(200,"text/html",PAGE);
 });
 web.on("/update",HTTP_POST,[](){
   if(!otaAuth){otaBusy=false;web.requestAuthentication();return;}
   if(otaOK&&!otaFailed){
     web.send(200,"text/plain","OTA SUCCESS. Rebooting...");
     otaRestart=true;otaRestartAt=millis()+3200;playVoice(VO_OTA_OK,3);
   }else{web.send(500,"text/plain",String("OTA FAILED: ")+Update.errorString());playVoice(VO_OTA_ERROR,3);}
   otaAuth=false;otaBusy=false;
 },uploadHandler);
 web.onNotFound([](){web.send(404,"text/plain","Not found");});
}
void enterOTA(){
 radioStop();
 snprintf(wifiName,sizeof(wifiName),"RC-TX-%04lX",(unsigned long)(esp_random()&0xffff));
 snprintf(wifiPass,sizeof(wifiPass),"%08lX%04lX",(unsigned long)esp_random(),(unsigned long)(esp_random()&0xffff));
 WiFi.mode(WIFI_AP);
 if(!WiFi.softAP(wifiName,wifiPass)){Serial.println("[OTA] softAP failed");radioStart();return;}
 web.begin();otaMode=true;playVoice(VO_OTA_ON,3);
 Serial.printf("[OTA] SSID=%s PASS=%s USER=admin URL=http://192.168.4.1\n",wifiName,wifiPass);
}
void leaveOTA(){
 if(otaBusy||otaRestart)return;
 web.stop();WiFi.softAPdisconnect(true);WiFi.mode(WIFI_OFF);
 otaMode=false;radioStart();playVoice(VO_OTA_OFF,3);
}
void onEncoderClick(uint32_t now);
void handleButtons(uint32_t now){
 int b=updateButton(button,now);
 updateButton(hoodSwitch,now);
 if(b==-1){
   uint32_t held=now-button.pressed;
   if(!button.consumed && held<650 && !otaMode){
     hornCounter++; // edge-triggered command for NEW RX V6 horn sound
     Serial.println("[HORN] short press");
   }
 }
 if(button.stable==LOW && !button.consumed && now-button.pressed>=OTA_HOLD_MS){
   button.consumed=true;
   if(!otaBusy && !otaRestart){if(otaMode)leaveOTA();else enterOTA();}
 }
 int sw=updateButton(encSwitch,now);
 if(sw==-1){
   uint32_t held=now-encSwitch.pressed;
   if(held>=1200 && !otaMode){
     if(screen==CALIBRATE || screen==EDIT || screen==SERVO_CAL){screen=MENU;pendingAction=0;playVoice(VO_CONFIG_UNSAVED);}
     else if(screen==MENU){screen=HOME;playVoice(VO_CONFIG_UNSAVED);}
   }else if(held<900 && !otaMode)onEncoderClick(now);
 }
}

void beginCalibration(MenuItem item){
 screen=CALIBRATE;editing=item;calStage=0;playVoice(VO_CAL_START);
 switch(item){
  case MI_CAL_THR:playVoice(VO_CAL_THROTTLE);break;
  case MI_CAL_STEER:playVoice(VO_CAL_STEER);break;
  case MI_CAL_SPEED:playVoice(VO_CAL_SPEED);break;
  case MI_CAL_TRIM:playVoice(VO_CAL_TRIM);break;
  case MI_CAL_GEAR:playVoice(VO_CAL_GEAR);break;
  default:break;
 }
}
int getCalibrationRaw(){
 switch(editing){
 case MI_CAL_THR:return adc.thr;
 case MI_CAL_STEER:return adc.steer;
 case MI_CAL_SPEED:return adc.speed;
 case MI_CAL_TRIM:return adc.trim;
 case MI_CAL_GEAR:return adc.gear;
 default:return 0;
 }
}
bool finishCalibration(){
 bool ok=false;
 if(editing==MI_CAL_THR){ok=abs(captured[0]-captured[1])>300;if(ok){cfg.throttle.lo=captured[0];cfg.throttle.hi=captured[1];}}
 if(editing==MI_CAL_STEER){
   ok=abs(captured[0]-captured[2])>200&&abs(captured[1]-captured[2])>200&&
      ((captured[0]<captured[2]&&captured[2]<captured[1]) || (captured[0]>captured[2]&&captured[2]>captured[1]));
   if(ok){cfg.steering.left=captured[0];cfg.steering.right=captured[1];cfg.steering.center=captured[2];}
 }
 if(editing==MI_CAL_SPEED){ok=abs(captured[0]-captured[1])>300;if(ok){cfg.speed.lo=captured[0];cfg.speed.hi=captured[1];}}
 if(editing==MI_CAL_TRIM){ok=abs(captured[0]-captured[1])>300;if(ok){cfg.trim.lo=captured[0];cfg.trim.hi=captured[1];}}
 if(editing==MI_CAL_GEAR){
   ok=abs(captured[0]-captured[1])>200 && abs(captured[2]-captured[1])>200 && abs(captured[0]-captured[2])>200;
   if(ok){for(int i=0;i<3;i++)cfg.gearAdc[i]=captured[i];}
 }
 if(ok){saveConfig(false);playVoice(VO_CAL_OK);}
 else playVoice(VO_CAL_FAIL,3);
 screen=MENU;return ok;
}

